    {
      "id": "US-615",
      "title": "Email notification fallback when WhatsApp delivery fails",
      "priority": "medium",
      "description": "WhatsApp is the primary order notification channel, but it can fail due to session expiry, number bans, or API downtime. Without a fallback, orders are silently missed. An email fallback (using Resend or Nodemailer) ensures the waiter still receives a notification with full order details. Email is secondary and only triggers after WhatsApp failure.",
      "acceptanceCriteria": [
        "An admin email address is configurable in site settings (waiter_email field)",
        "When the WhatsApp notification fails after all retries, the system sends a fallback email with full order details (items, quantities, total, customer contact, ETA)",
        "The email subject line: '[URGENT] New Pre-Order — [Order ID] — WhatsApp failed'",
        "Email sends are logged with order ID, timestamp, and success/failure status",
        "The admin Orders panel shows a 'Notified via email' badge when the fallback was used",
        "Email fallback does not send when WhatsApp succeeds"
      ],
      "technicalNotes": [
        "Recommended library: Resend (resend.com) — simplest Node.js email API, free tier 100 emails/day",
        "Alternative: Nodemailer + Gmail SMTP with app password",
        "npm install resend — API key stored in RESEND_API_KEY env var",
        "Reference: https://resend.com/docs/send-with-nextjs",
        "Order details HTML template should be a simple inline-styled table for email client compatibility"
      ],
      "dependencies": [
        "WhatsApp order notification delivery retry with exponential backoff"
      ],
      "estimatedComplexity": "medium",
      "passes": false
    },
    {
      "id": "US-616",
      "title": "Payment screenshot client-side validation: size, format, and dimension check",
      "priority": "medium",
      "description": "The payment screenshot upload currently accepts any file type and size, which risks storing invalid files (e.g., a 20MB RAW photo, a non-image document) in the database or CDN. Client-side validation before upload improves UX with immediate feedback and reduces unnecessary uploads, while server-side validation enforces security limits.",
      "acceptanceCriteria": [
        "Client-side validation rejects files > 5MB with message: 'File too large. Max 5MB.'",
        "Client-side validation rejects non-image MIME types (only image/jpeg, image/png, image/webp, image/heic accepted)",
        "Client side shows a thumbnail preview of the selected image before upload",
        "Server-side /api/orders/[id]/payment validates file size (< 5MB) and MIME type before processing",
        "Server returns 413 with a JSON error body if the file is too large",
        "HEIC files from iPhone are accepted (common for Malaysian iPhone users); the server or client converts to JPEG if needed"
      ],
      "technicalNotes": [
        "Client-side: check file.size and file.type in the onChange handler before allowing the upload to proceed",
        "HEIC detection: file.type may be 'image/heic' or 'image/heif' — check both",
        "For HEIC conversion: use the heic2any npm package client-side (no server dependency needed)",
        "Server-side: check Content-Length header and file.mimetype (if using formidable or similar)",
        "Reference: https://developer.mozilla.org/en-US/docs/Web/API/File/size"
      ],
      "dependencies": [],
      "estimatedComplexity": "small",
      "passes": false
    },
