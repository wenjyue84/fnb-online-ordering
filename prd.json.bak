    {
      "id": "US-618",
      "title": "Multi-tab POS state sync via BroadcastChannel API",
      "priority": "low",
      "description": "When staff have the POS dashboard open in multiple browser tabs on the same device (e.g., kitchen tablet with two windows), order status updates from one tab are not reflected in the other. The BroadcastChannel API provides a zero-cost same-origin message channel to synchronise order state across tabs without a WebSocket server, which is ideal for a single-device kitchen setup.",
      "acceptanceCriteria": [
        "When an order's status changes in one POS tab (e.g., tapped 'Move to Preparing'), the other tabs update within 200ms",
        "New order cards received via SSE in one tab are broadcast to all other POS tabs",
        "Tab that originates the action does not re-process its own broadcast message (sender exclusion via a unique tab ID)",
        "BroadcastChannel is set up in a useEffect hook and closed on component unmount",
        "The feature degrades gracefully in browsers without BroadcastChannel support (Firefox < 38, older Safari) — no error thrown"
      ],
      "technicalNotes": [
        "const channel = new BroadcastChannel('pos-orders'); channel.postMessage({ type: 'order_updated', order }); channel.onmessage = (e) => handleRemoteUpdate(e.data)",
        "Generate a unique tabId with crypto.randomUUID() on mount; include it in all broadcast messages; ignore messages with own tabId",
        "BroadcastChannel works across tabs within the same origin — does NOT work across devices (use WebSocket for multi-device)",
        "Reference: https://developer.mozilla.org/en-US/docs/Web/API/BroadcastChannel",
        "Check support: 'BroadcastChannel' in window before initialising"
      ],
      "dependencies": [],
      "estimatedComplexity": "small",
      "passes": false
    },
