# Database (Neon Serverless Postgres)
DATABASE_URL=postgresql://user:pass@host.neon.tech/dbname?sslmode=require

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here
ADMIN_JWT_SECRET=at-least-32-chars-random-secret

# AI Waiter
GROQ_API_KEY=gsk_xxx
OPENROUTER_API_KEY=sk-or-xxx

# Site
NEXT_PUBLIC_SITE_URL=https://makanmoments.cafe

# WhatsApp CTA (optional)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WhatsApp Order Notifications (pre-order alerts sent to waiter)
WAITER_WHATSAPP_NUMBER=601XXXXXXXXX
WHATSAPP_API_URL=https://your-whatsapp-api/send
WHATSAPP_API_KEY=your-whatsapp-api-key

# Vercel Blob Storage (payment screenshots — auto-provisioned on Vercel, leave blank for local dev fallback)
BLOB_READ_WRITE_TOKEN=

# PWA Push Notifications (generate with: node -e "const wp=require('web-push'); console.log(wp.generateVAPIDKeys())")
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@makanmoments.cafe

# Kitchen Display System (KDS)
KITCHEN_USERNAME=kitchen
KITCHEN_PASSWORD=kitchen123

# REMOVED — Notion no longer used:
# NOTION_API_KEY
# NOTION_MENU_DB_ID
# NOTION_BLOG_DB_ID
